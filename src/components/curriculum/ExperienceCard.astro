---
import Skill from './Skill.astro';

type Role = {
  grade: string;
  startDate: string;
  endDate?: null | string;
  goals: string[];
};

type Props = {
  site: string;
  grade?: string;
  startDate?: null | string;
  endDate?: null | string;
  onlyShowEndDate?: boolean;
  goals?: string[];
  roles?: Role[];
  location: string;
  url?: string | null;
  isRemote?: boolean;
  technologies?: string[];
};

const LOCALE: Intl.LocalesArgument = 'en-US';
const LOCALE_DATE_CONFIG: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
};

const {
  startDate,
  endDate,
  isRemote = false,
  onlyShowEndDate = false,
  ...experience
} = Astro.props;

function formatDate(date: string) {
  return new Date(date).toLocaleDateString(LOCALE, LOCALE_DATE_CONFIG);
}

function getStartDate() {
  if (onlyShowEndDate) {
    return null;
  }

  if (!startDate) return null;

  return formatDate(startDate);
}

function getEndDate() {
  const isCurrent = endDate === null;

  if (isCurrent) return 'Present';

  if (!endDate) return '';
  return formatDate(endDate);
}

function getRoleRange(role: Role) {
  const end = role.endDate ? formatDate(role.endDate) : 'Present';
  return `${formatDate(role.startDate)} - ${end}`;
}

const startDateLocaleString = getStartDate();
const endDateLocaleString = getEndDate();
const placeWork = isRemote ? 'Remote' : 'On-site';
const roles = experience.roles ?? [];
---

<article>
  <header class="flex flex-col justify-between gap-x-2 md:flex-row md:items-center print:flex-row">
    <div class="flex flex-col">
      <span class="text-base font-bold print:text-cv-body">{experience.site}</span>
      {
        experience.grade && (
          <h6 class="text-base print:text-cv-body">
            {experience.grade}
            <br />
          </h6>
        )
      }
    </div>

    <div class="flex flex-col md:items-end print:items-end">
      <span class="text-base not-print:text-indigo-400 print:text-cv-body print:font-bold">
        {experience.location ? experience.location : ''}
        <span class="font-bold italic not-print:text-indigo-400 print:hidden">({placeWork})</span>
      </span>
      {
        (startDateLocaleString || endDateLocaleString) && (
          <span class="text-base text-nowrap print:text-cv-body">
            {startDateLocaleString}
            {startDateLocaleString && endDateLocaleString && '-'}
            {endDateLocaleString}
          </span>
        )
      }
    </div>
  </header>
  {
    roles.length > 0 ? (
      <div class="mt-1 flex flex-col gap-y-2 print:gap-y-1">
        {roles.map((role) => (
          <section>
            <div class="flex flex-col justify-between gap-x-2 md:flex-row print:flex-row">
              <h6 class="text-base font-semibold print:text-cv-body">{role.grade}</h6>
              <span class="text-base text-nowrap not-print:text-neutral-400 print:text-cv-body">
                {getRoleRange(role)}
              </span>
            </div>
            <ul class="list-disc px-8 text-base not-print:text-neutral-400 print:text-cv-body">
              {role.goals.map((goal) => (
                <li>{goal}</li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <div class="mt-2 text-base not-print:text-neutral-400 print:text-cv-body">
        <ul class="list-disc px-8 text-base print:text-cv-body">
          {experience.goals && experience.goals.map((goal) => <li>{goal}</li>)}
        </ul>
      </div>
    )
  }
  {
    experience.technologies && (
      <div class="mt-2">
        {experience.technologies.sort().map((tech) => (
          <Skill technology={tech} />
        ))}
      </div>
    )
  }
</article>
