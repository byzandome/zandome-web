---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { ui, type Locale } from '@/i18n/cover-letter';
import Layout from '@/layouts/Base.astro';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = ui[locale];
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';

const LINKEDIN_URL = 'https://www.linkedin.com/in/zandome';
const EMAIL = 'miguel@zandome.dev';
const years = new Date().getFullYear() - 2018;

const switchHref = getRelativeLocaleUrl(otherLocale, 'cover-letter');
const intro = t.intro.replace('{years}', String(years));
---

<Layout title={t.pageTitle}>
  <div class="mx-auto max-w-3xl py-10">
    <div class="mb-6 flex items-center justify-between">
      <a
        href="/cv"
        class="text-sm text-indigo-400 transition-colors hover:text-indigo-300 hover:underline"
      >
        {t.backToCV}
      </a>
      <a
        href={switchHref}
        class="rounded-full border border-indigo-400/40 px-3 py-1 text-sm text-indigo-400 transition-colors hover:border-indigo-400 hover:bg-indigo-400/10"
      >
        {t.switchLang}
      </a>
    </div>

    <div class="rounded-xl border border-white/10 bg-white/5 p-8 md:p-12">
      <!-- Header -->
      <header class="mb-8 border-b border-white/10 pb-8">
        <h1 class="text-2xl font-bold">Miguel Enrique Mendoza Rivero</h1>
        <p class="mt-1 text-indigo-400">Senior Frontend Engineer & Tech Lead</p>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-neutral-400">
          <span>{t.location}</span>
          <a href={`mailto:${EMAIL}`} class="hover:text-indigo-400 hover:underline">{EMAIL}</a>
          <a
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-indigo-400 hover:underline"
          >
            linkedin.com/in/zandome
          </a>
        </div>
      </header>

      <!-- Salutation -->
      <p class="mb-6 font-medium">{t.salutation}</p>

      <!-- Body -->
      <div class="flex flex-col gap-y-5 leading-relaxed text-neutral-300">
        <p>{intro}</p>
        <p>{t.experience}</p>
        <p>{t.differentiator}</p>
        <p>{t.learning}</p>
        <p>
          {t.contactBefore}<a href={`mailto:${EMAIL}`} class="text-indigo-400 hover:underline"
            >{EMAIL}</a
          >{t.contactOr}<a
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-indigo-400 hover:underline">LinkedIn</a
          >.
        </p>
        <p>{t.closing}</p>
      </div>

      <!-- Signature -->
      <div class="mt-10 border-t border-white/10 pt-8">
        <p class="mb-1 text-sm text-neutral-400">{t.signOff}</p>
        <p class="font-semibold">Miguel Enrique Mendoza Rivero</p>
        <p class="text-sm text-indigo-400">Senior Frontend Engineer & Tech Lead</p>
      </div>
    </div>
  </div>
</Layout>
