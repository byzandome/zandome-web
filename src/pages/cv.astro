---
import { ArrowRight } from '@lucide/astro';
import { Icon } from 'astro-icon/components';
import { Picture } from 'astro:assets';

import Certificates from '@/assets/data/certificates.json';
import Jobs from '@/assets/data/jobs.json';
import PictureProfile from '@/assets/images/profile-picture.png';
import { ExperienceCard } from '@/components/curriculum';
import Layout from '@/layouts/CV.astro';

const LINKEDIN_USERNAME = 'zandome';
const WEBSITE_DOMAIN = 'zandome.dev';
const LINKEDIN_URL = `https://www.linkedin.com/in/${LINKEDIN_USERNAME}`;
const EMAIL = `miguel@${WEBSITE_DOMAIN}`;
const PHONE_NUMBER = import.meta.env.PHONE_NUMBER;
const PHONE_NUMBER_URL = `tel:${PHONE_NUMBER}`;
const EMAIL_URL = `mailto:${EMAIL}`;
const yearsOfExperience = new Date().getFullYear() - 2018;
---

<Layout>
  <div class="flex flex-col gap-y-4 print:gap-y-2">
    <!-- Profile Picture -->
    <section class="flex flex-col items-center justify-center gap-y-2">
      <Picture
        formats={['webp', 'jpeg']}
        format="webp"
        src={PictureProfile}
        alt="Profile"
        loading="eager"
        fetchpriority="high"
        transition:name="profile"
        class="aspect-square w-30 rounded-full object-cover not-print:border-2 not-print:border-white print:w-20"
      />
      <div class="flex flex-col items-center justify-center">
        <h1 class="text-center text-2xl font-bold print:text-cv-title">
          Miguel Enrique Mendoza Rivero
        </h1>
        <h2 class="text-center text-xl print:text-cv-subtitle">
          Senior Frontend Engineer & Tech Lead
        </h2>
      </div>
      <div aria-label="Contact" class="cv__contact">
        <a href={EMAIL_URL} class="cv__contact__item hover:underline">
          <Icon name="mdi:email" class="text-base print:text-cv-body" />
          <span>
            {EMAIL}
          </span>
        </a>
        <a href={LINKEDIN_URL} class="cv__contact__item hover:underline">
          <Icon name="mdi:linkedin" class="text-base print:text-cv-body" />
          <span>{LINKEDIN_URL}</span>
        </a>
        {
          PHONE_NUMBER && (
            <a href={PHONE_NUMBER_URL} class="cv__contact__item hover:underline">
              <Icon name="mdi:phone" class="text-base print:text-cv-body" />
              <span>{PHONE_NUMBER}</span>
            </a>
          )
        }
        <div class="cv__contact__item">
          <Icon name="mdi:map-marker" class="text-base print:text-cv-body" />
          <span>Madrid, Spain</span>
        </div>
      </div>
    </section>
    <section class="cv__section border-t border-t-gray-400 pt-2" aria-label="Summary">
      <p class="print:text-cv-body print:italic">
        Self-taught Senior Frontend Engineer and Tech Lead with over {yearsOfExperience} years of experience
        building and architecting scalable web and mobile products. Specialized in React and Next.js ecosystems,
        microfrontend architectures, and component-driven design systems. Consistent track record of leading
        engineering teams, defining frontend strategy, and delivering measurable technical impact across
        fintech, eCommerce, and SaaS industries.
      </p>
    </section>
    <section class="cv__section" aria-label="Experience">
      <header class="flex items-center gap-x-4 border-b border-b-gray-400">
        <h3 class="cv__section__title">Experience</h3>
      </header>
      <div class="flex flex-col gap-y-4 print:gap-y-1">
        {Jobs.map((job) => <ExperienceCard {...job} />)}
      </div>
    </section>
    <section class="cv__section" aria-label="Education">
      <header class="flex items-center gap-x-4 border-b border-b-gray-400">
        <h3 class="cv__section__title">Education</h3>
      </header>
      <ExperienceCard
        site="U.E. Colegio del Santisimo"
        grade="High School"
        endDate="2018-07-18T00:00:00+00:00"
        onlyShowEndDate
        location="Barquisimeto, Venezuela"
      />
    </section>
    <section class="cv__section print:hidden" aria-label="Certifications">
      <header class="flex items-center justify-between gap-x-4 border-b border-b-gray-400">
        <h3 class="cv__section__title">Certifications</h3>
        <a
          href="/certificates"
          class="flex items-center gap-x-1 rounded-full border border-indigo-400/40 px-3 py-0.5 text-xs text-indigo-400 transition-colors hover:border-indigo-400 hover:bg-indigo-400/10"
        >
          View all <ArrowRight class="h-3 w-3" />
        </a>
      </header>
      <div class="flex flex-col gap-y-2">
        {
          Certificates.filter((group) => group.items.some((cert) => cert.visibleInCV)).map(
            (group) => (
              <div>
                <h4 class="text-sm font-semibold text-gray-400">{group.category}</h4>
                <ul class="list-disc pl-8 text-base">
                  {group.items
                    .filter((cert) => cert.visibleInCV)
                    .map((cert) => (
                      <li>
                        <a
                          href={`/certificates/${cert.file}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="hover:underline"
                        >
                          {cert.name}
                        </a>
                        <span class="text-sm text-gray-400"> · {cert.platform}</span>
                      </li>
                    ))}
                </ul>
              </div>
            ),
          )
        }
      </div>
    </section>
    <section class="cv__section" aria-label="Languages">
      <header class="flex items-center gap-x-4 border-b border-b-gray-400">
        <h3 class="cv__section__title">Languages</h3>
      </header>
      <ul class="list-disc pl-8 text-base print:text-cv-body">
        <li>Spanish <span>(native)</span></li>
        <li>English <span>(B2)</span></li>
      </ul>
    </section>
    <section class="cv__section" aria-label="Skills">
      <header class="flex items-center gap-x-4 border-b border-b-gray-400">
        <h3 class="cv__section__title">Skills</h3>
      </header>
      <ul class="list-disc pl-8 text-base print:text-cv-body">
        <li>
          <span class="text-base font-bold print:text-cv-body">Technical Leadership</span>
          <p class="text-base print:text-cv-body">
            Led teams of up to 9 engineers, enforced coding standards, drove architectural
            decisions, and mentored mid and junior developers across multiple projects and
            companies.
          </p>
        </li>
        <li>
          <span class="text-base font-bold print:text-cv-body"
            >Problem Solving & Critical Thinking</span
          >
          <p class="text-base print:text-cv-body">
            Track record of identifying root causes in complex systems and proposing architectural
            changes that delivered measurable improvements in performance and maintainability.
          </p>
        </li>
        <li>
          <span class="text-base font-bold print:text-cv-body">Cross-Functional Collaboration</span>
          <p class="text-base print:text-cv-body">
            Experienced working alongside product, design, CRO, and backend teams to align technical
            execution with business and user goals.
          </p>
        </li>
        <li>
          <span class="text-base font-bold print:text-cv-body">Product-Oriented Mindset</span>
          <p class="text-base print:text-cv-body">
            Prioritizes usability, performance, and real business outcomes — not just technical
            correctness — in every architectural and implementation decision.
          </p>
        </li>
        <li>
          <span class="text-base font-bold print:text-cv-body"
            >Fast Learning & Self-Driven Growth</span
          >
          <p class="text-base print:text-cv-body">
            Fully self-taught engineer with no formal CS degree who has independently mastered web,
            mobile, and native development across multiple stacks. Consistently picked up unfamiliar
            technologies to meet project needs — from Swift and SwiftUI to Flutter and Electron —
            and contributed meaningfully from day one.
          </p>
        </li>
        <li>
          <span class="text-base font-bold print:text-cv-body">Adaptability to Project Needs</span>
          <p class="text-base print:text-cv-body">
            Adapts technical approach to what each project actually requires, not to personal
            preferences. Has shifted roles, stacks, and domains across startups and large
            organizations — stepping into mobile, backend, and leadership contexts whenever the
            situation demanded it.
          </p>
        </li>
      </ul>
    </section>
  </div>
</Layout>
