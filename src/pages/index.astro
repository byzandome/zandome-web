---
import { Icon } from 'astro-icon/components';
import { Picture } from 'astro:assets';

import PictureProfile from '@/assets/images/profile-picture.png';
// import Button from '@/components/shared/Button.astro';
import { Button } from '@/components/ui';
import Layout from '@/layouts/Base.astro';
---

<Layout title="Miguel Mendoza | Zandome">
  <section class="container mx-auto h-dvh">
    <div class="flex min-h-dvh w-full flex-col gap-y-10 md:flex-row">
      <div class="order-2 flex flex-col items-baseline justify-center md:order-1 md:flex-1">
        <h1>
          <span class="block font-mono text-2xl italic text-shadow-indigo-300"> Hello there!</span>
          <span class="bold block text-5xl"> I'm Miguel Mendoza</span>
        </h1>
        <p class="mt-6">
          Self-taught engineer, 8+ years building web and mobile products, now a Software
          Engineering Manager. I like turning hard problems into systems a team can understand and
          keep alive: frontend architecture, design systems and legacy migrations. I stay close to
          the code, learn things properly and share what I learn.
        </p>
        <div class="mt-8 flex flex-row items-center gap-x-4">
          <a href="/projects">
            <Button>See my work</Button>
          </a>
          <a href="/cv">
            <Button variant="outline">Read my CV</Button>
          </a>
          <a
            href="https://instagram.com/byzandome"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <Icon name="mdi:instagram" size={24} class="text-indigo-400" />
          </a>
          <a
            href="https://linkedin.com/in/zandome"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <!-- <Button variant="link" size="icon-lg"> -->
            <Icon name="mdi:linkedin" size={24} class="text-indigo-400" />
            <!-- </Button> -->
          </a>
          <a
            href="https://github.com/byzandome"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
            <!-- <Button variant="link" size="icon-lg"> -->
            <Icon name="mdi:github" size={24} class="text-indigo-400" />
            <!-- </Button> -->
          </a>
          <!-- <Button>Contact</Button> -->
        </div>
      </div>
      <div class="order-1 flex items-center justify-center md:order-2 md:flex-1">
        <div class="flex w-2/3 items-center justify-center">
          <Picture
            formats={['webp', 'jpeg']}
            format="webp"
            src={PictureProfile}
            alt="Profile"
            loading="eager"
            fetchpriority="high"
            transition:animate="slide"
            transition:name="profile"
            class="aspect-square rounded-full border-2 border-white object-cover"
          />
        </div>
      </div>
    </div>
  </section>
</Layout>
