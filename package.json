{
  "name": "zandome-web",
  "type": "module",
  "version": "1.5.0",
  "engines": {
    "node": "24.x"
  },
  "license": "MIT",
  "author": "Miguel Mendoza",
  "description": "Miguel Mendoza Portfolio Web",
  "contributors": [
    {
      "name": "Miguel Mendoza",
      "email": "miguel@zandome.com",
      "url": "https://zandome.com"
    }
  ],
  "packageManager": "bun@1.4.3",
  "scripts": {
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format:check:all": "prettier --check .",
    "format:check:staged": "prettier --check ",
    "format:fix:all": "prettier --write .",
    "format:ci": "prettier --check .",
    "format": "bun run format:check:all",
    "lint:check:all": "eslint .",
    "lint:check:staged": "eslint ",
    "lint:fix:all": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "lint": "bun run lint:check:all",
    "typecheck": "astro check",
    "deps:update": "bunx npm-check-updates --interactive --format group",
    "pre-commit": "lint-staged",
    "changeset": "changeset",
    "version": "changeset version && bun install --frozen-lockfile",
    "release": "changeset tag"
  },
  "dependencies": {
    "@astrojs/partytown": "2.1.8",
    "@astrojs/react": "7.1.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/stix-two-text": "^5.3.0",
    "@lucide/astro": "^1.59.0",
    "@playform/compress": "^0.2.5",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.0",
    "astro-icon": "^1.2.0",
    "astro-pdf": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@sparticuz/chromium": "^153.0.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "bun-types": "1.4.3",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxc-transform-react": "^0.154.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer": "^25.14.0",
    "puppeteer-core": "^25.14.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.71.2"
  }
}
